{
  "name": "@workspace/registry",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/ui": "*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5"
  },
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*/index.d.ts",
      "default": "./dist/blocks/*/index.js"
    },
    "./components/*/meta": {
      "types": "./dist/components/*/meta.d.ts",
      "default": "./dist/components/*/meta.js"
    },
    "./blocks/*/meta": {
      "types": "./dist/blocks/*/meta.d.ts",
      "default": "./dist/blocks/*/meta.js"
    }
  }
}